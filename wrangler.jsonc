{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xml",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Bindings are pinned by id so Cloudflare reuses these existing resources
  // instead of trying to auto-provision (re-create) them on each deploy.
  "kv_namespaces": [{ "binding": "SESSION", "id": "da28ae92ba494473833f606785043fbe" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db",
      "database_id": "3aa489d6-f947-4714-be41-6187f987c0e6",
      "migrations_dir": "migrations"
    }
  ],
  // Object storage for invoice PDFs (raw bytes) so they don't bloat D1.
  // Create the bucket first: `npx wrangler r2 bucket create xml-pdfs`.
  "r2_buckets": [{ "binding": "PDFS", "bucket_name": "xml-pdfs" }],
  // Which model runs each of Ivan's steps. Sonnet scored 18/18 on the quiz (=Opus)
  // at ~half the cost, so we run it here. Model names aren't secret, so they live
  // in config (deploys automatically). Change a value to switch a step; delete a
  // key to fall back to Opus for that step.
  "vars": {
    "AI_MODEL_SQL": "claude-sonnet-5",
    "AI_MODEL_REVIEW": "claude-sonnet-5",
    "AI_MODEL_SUMMARY": "claude-sonnet-5",
    // Which repo "Collect now" dispatches the collector workflow on. Not secret
    // (just an owner/repo string), so it lives here rather than as a Worker secret.
    "GITHUB_REPO": "shedden10/shedden10-SHEDDEN"
  }
  // The Astro Cloudflare adapter injects the Worker entry + static assets at
  // build time, so `main`/`assets` are intentionally omitted here.
  //
  // Secrets (TOKEN_ENC_KEY, INGEST_TOKEN, APP_PASSWORD) are NOT stored here.
  // Locally they live in .dev.vars; in production set them with:
  //   npx wrangler secret put TOKEN_ENC_KEY
}
